{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chloelabs-learn-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5.4-mini",
    "ALLOWED_ORIGIN": "https://chloelabs.github.io"
  },
  "ratelimits": [
    {
      "name": "LEARN_RATE_LIMITER",
      "namespace_id": "20260724",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
